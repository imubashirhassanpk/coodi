{
  "$schema": "https://www.mubashirhassan.com/coodi/schemas/extension.json",
  "id": "coodi.kotlin",
  "name": "Kotlin",
  "displayName": "Kotlin",
  "version": "1.0.0",
  "description": "Kotlin language support with LSP",
  "publisher": "Coodi",
  "categories": ["Language"],
  "languages": [
    {
      "id": "kotlin",
      "extensions": [".kt", ".kts"],
      "aliases": ["Kotlin"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "kotlin-language-server",
      "runtime": "binary",
      "args": []
    }
  }
}
