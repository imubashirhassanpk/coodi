{
  "$schema": "https://www.mubashirhassan.com/coodi/schemas/extension.json",
  "id": "coodi.rust",
  "name": "Rust",
  "displayName": "Rust",
  "version": "1.0.0",
  "description": "Rust language support with LSP",
  "publisher": "Coodi",
  "categories": ["Language"],
  "languages": [
    {
      "id": "rust",
      "extensions": [".rs"],
      "aliases": ["Rust", "rs"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "rust-analyzer",
      "runtime": "binary",
      "downloadUrl": "https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-${targetArch}-${targetOs}.${archiveExt}"
    }
  }
}
